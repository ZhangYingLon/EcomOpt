/* EcomOpt 全局样式 - 界面美观 */
/* 主窗口与全局 */
QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    background-color: #f5f6f8;
}

QMainWindow {
    background-color: #f5f6f8;
}

/* 选项卡 */
QTabWidget::pane {
    border: 1px solid #e0e2e5;
    border-radius: 6px;
    background-color: #ffffff;
    margin-top: 4px;
    padding: 8px;
}

QTabBar::tab {
    background-color: #e8eaed;
    color: #3c4043;
    padding: 8px 18px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-width: 72px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a73e8;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #d2d6da;
}

/* 分组框 */
QGroupBox {
    font-weight: bold;
    border: 1px solid #e0e2e5;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 12px 8px 12px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #3c4043;
}

/* 按钮 */
QPushButton {
    background-color: #1a73e8;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    min-width: 72px;
}

QPushButton:hover {
    background-color: #1765cc;
}

QPushButton:pressed {
    background-color: #1557b0;
}

QPushButton:disabled {
    background-color: #a8b3c0;
    color: #e8eaed;
}

/* 表格 */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #e8eaed;
    border: 1px solid #e0e2e5;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 6px 8px;
}

QHeaderView::section {
    background-color: #f1f3f4;
    color: #3c4043;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #e0e2e5;
    font-weight: bold;
}

/* 输入框 */
QLineEdit, QTextEdit, QPlainTextEdit {
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #ffffff;
    selection-background-color: #1a73e8;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #1a73e8;
}

QComboBox {
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #ffffff;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #1a73e8;
}

/* 列表 */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e0e2e5;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}

/* 进度条 */
QProgressBar {
    border: 1px solid #e0e2e5;
    border-radius: 4px;
    text-align: center;
    background-color: #f1f3f4;
}

QProgressBar::chunk {
    background-color: #1a73e8;
    border-radius: 3px;
}

/* 滚动条 */
QScrollBar:vertical {
    width: 10px;
    margin: 0;
    background-color: #f1f3f4;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    background-color: #bdc1c6;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9aa0a6;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
    background-color: #f1f3f4;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
    background-color: #bdc1c6;
    border-radius: 5px;
}

/* 状态栏 */
QStatusBar {
    background-color: #e8eaed;
    color: #5f6368;
}
